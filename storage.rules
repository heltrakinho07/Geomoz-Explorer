rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Every GIS object is isolated by authenticated user and project.
    match /users/{userId}/projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny: no cross-user or public object access through Firebase Storage rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
