rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each authenticated user has full read/write isolation over their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Project Workspaces
      match /projects/{projectId} {
        // Creation/deletion goes through the authenticated quota service.
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;

        // Study Runs & Analyses within project
        match /runs/{runId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // GIS Workspace lightweight state/manifest. Large datasets live in Storage.
        match /workspace/{documentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /workspaceLayers/{layerId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /processingRuns/{runId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /models/{modelId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Credentials & GEE OAuth tokens
      match /credentials/{credId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User Settings & GEE preferences
      match /settings/{settingId} {
        // Legacy gee settings must never expose access/refresh tokens or
        // service account private keys to the browser. Backend migration
        // moves historical credentials into Admin-only geePrivateSessions.
        allow read: if request.auth != null && request.auth.uid == userId
          && (settingId != "gee" || resource.data.keys().hasOnly([
            "project", "account", "connected", "connectedAt", "updatedAt"
          ]));
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (settingId != "gee" || request.resource.data.keys().hasOnly([
            "project", "account", "connected", "connectedAt", "updatedAt"
          ]));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Billing, checkout and project quota ledgers: Firebase Admin only.
    match /billing/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      match /{nested=**} { allow read, write: if false; }
    }
    match /billingPayments/{paymentId} { allow read, write: if false; }
    match /billingCheckoutState/{userId} { allow read, write: if false; }
    match /billingEvents/{eventId} { allow read, write: if false; }
    match /billingProjectQuota/{userId} { allow read, write: if false; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
