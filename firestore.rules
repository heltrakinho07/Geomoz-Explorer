rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each authenticated user has full read/write isolation over their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Project Workspaces
      match /projects/{projectId} {
        // All creation/deletion goes through the Firebase Admin API so plan
        // quotas cannot be bypassed by a forged browser request.
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;

        // Runs remain editable by the owner, but only inside extant projects.
        match /runs/{runId} {
          allow read, delete: if request.auth != null && request.auth.uid == userId;
          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
        }
      }

      // Credentials & GEE OAuth tokens
      match /credentials/{credId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User Settings & GEE preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
