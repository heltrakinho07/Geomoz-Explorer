rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Each authenticated user has full read/write isolation over their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Project Workspaces
      match /projects/{projectId} {
        // Only the authenticated backend may create/delete cloud projects;
        // server transaction enforces plan quota across concurrent requests.
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;

        // Study Runs & Analyses within project
        match /runs/{runId} {
          allow read, write: if request.auth != null && request.auth.uid == userId &&
          exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));
        }
      }

      // Credentials & GEE OAuth tokens
      match /credentials/{credId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User Settings & GEE preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Billing entitlements, payment events and consumption are server-owned.
    // A client cannot promote its own plan, mint credits or forge a payment.
    match /billing/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      match /{nested=**} { allow read, write: if false; }
    }
    match /billingEvents/{eventId} { allow read, write: if false; }
    match /billingPayments/{paymentId} { allow read, write: if false; }
    match /billingCheckoutState/{userId} { allow read, write: if false; }
    match /billingProjectQuota/{userId} { allow read, write: if false; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
